  "dependencies": {
    "vue": "3.5.30"
  },
  "devDependencies": {
    "vite": "7.3.1",
    "@vitejs/plugin-vue": "6.0.4",
    "typescript": "5.9.3",
    "vue-tsc": "3.2.5",
    "openapi-typescript": "7.10.1"
  }
}
